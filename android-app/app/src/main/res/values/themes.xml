<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RomaEventsApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/roma_orange</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/roma_orange_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>

        <!-- BottomNavigationView Styling -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface_dark</item>
        <item name="itemIconTint">@color/sel_bottom_nav</item>
        <item name="itemTextColor">@color/sel_bottom_nav</item>
        <item name="itemRippleColor">@color/roma_orange_light</item>
        <item name="itemActiveIndicatorStyle">@style/App.BottomNav.Indicator</item>
    </style>

    <style name="App.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/roma_orange_dark</item>
    </style>

    <style name="Theme.RomaEventsApp" parent="Base.Theme.RomaEventsApp" />
</resources>