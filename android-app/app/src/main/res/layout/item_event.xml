<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="12dp"
    app:cardCornerRadius="48dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="@color/surface_dark"
    app:strokeWidth="1.5dp"
    app:strokeColor="#1AFFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <!-- Categoria Pill -->
        <TextView
            android:id="@+id/categoryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_category_tag"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="CULTURA"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Stato Badge -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●  PROSSIMO"
            android:textColor="@color/roma_orange"
            android:textSize="10sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            app:layout_constraintTop_toTopOf="@id/categoryText"
            app:layout_constraintBottom_toBottomOf="@id/categoryText"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Titolo Hero -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:text="Titolo dell'Evento"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:fontFamily="sans-serif-black"
            android:lineSpacingExtra="2dp"
            app:layout_constraintTop_toBottomOf="@id/categoryText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevronIcon" />

        <!-- Firma Arancio -->
        <View
            android:id="@+id/accentLine"
            android:layout_width="55dp"
            android:layout_height="4.5dp"
            android:layout_marginTop="20dp"
            android:background="@color/roma_orange"
            app:layout_constraintTop_toBottomOf="@id/titleText"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Info Data -->
        <TextView
            android:id="@+id/dateText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="📅  Data dell'evento"
            android:textColor="#F2FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toBottomOf="@id/accentLine"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevronIcon" />

        <!-- Info Luogo -->
        <TextView
            android:id="@+id/addressText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📍  Roma, Italia"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/dateText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevronIcon" />

        <!-- Icona Freccia Navigazione Premium -->
        <ImageView
            android:id="@+id/chevronIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/roma_orange"
            android:background="@drawable/bg_category_tag"
            android:backgroundTint="#1AFFFFFF"
            android:padding="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Vedi Dettaglio" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>